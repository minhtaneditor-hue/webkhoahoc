# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_BASE_URL=https://your-domain.com
NEXT_PUBLIC_ADMIN_EMAIL=

# VNPay (sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html)
# In the VNPay merchant portal set IPN URL = https://your-domain.com/api/webhooks/payment
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=

# Email (Resend)
RESEND_API_KEY=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" automatically
CRON_SECRET=

# DRM video server
DRM_SECRET=
NEXT_PUBLIC_DRM_SERVER_URL=

# SePay bank transfer (VietQR). When SEPAY_BANK_ACCOUNT + SEPAY_BANK_NAME are set,
# checkout uses bank transfer instead of VNPay.
# SePay webhook URL: https://www.minhtanacademy.com/api/webhooks/sepay  (auth: API Key)
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=            # SePay short bank name, e.g. MBBank, Vietcombank, Techcombank
SEPAY_ACCOUNT_NAME=         # shown on the payment page, e.g. LE MINH TAN
SEPAY_WEBHOOK_SECRET=       # HMAC-SHA256 auth: the Secret Key shown on the SePay webhook (recommended)
SEPAY_WEBHOOK_KEY=          # or API Key auth: the key you typed on the SePay webhook

# Meta Conversions API (Events Manager → Web MTA → Cài đặt → API Chuyển đổi → Tạo mã truy cập). SERVER ONLY.
# The pixel id comes from Admin > Nội dung & liên hệ. Leave the token empty to send nothing.
META_CAPI_ACCESS_TOKEN=
# Optional: test code from Events Manager → Thử nghiệm sự kiện. Remove it after testing.
META_CAPI_TEST_CODE=

# Claude API for the AI advisor (/api/chat). Server-only, never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional: CHAT_MODEL=claude-haiku-5-5, CHAT_DAILY_LIMIT=20
# Chấm video miễn phí (/cham-video): model và số lượt mỗi IP mỗi ngày (không bắt buộc)
# CHAM_MODEL=claude-sonnet-5-5
# CHAM_DAILY_LIMIT=3
# Viết kịch bản (/viet-kich-ban): model viết và model hỏi bổ sung (không bắt buộc)
# SCRIPT_MODEL=claude-sonnet-5-5
# SCRIPT_ASK_MODEL=claude-haiku-5-5

# Facebook Messenger AI (Admin > Facebook Messenger). Setup steps: docs/facebook-messenger.md. SERVER ONLY.
FB_PAGE_ACCESS_TOKEN=       # Page access token (Meta app > Messenger > Cài đặt API)
FB_APP_SECRET=              # Meta app > Cài đặt > Thông tin cơ bản > Khóa bí mật
FB_APP_ID=                  # Meta app id: tells the bot's own echoes apart from replies you type in the Page inbox
FB_VERIFY_TOKEN=            # any random string, typed again in the webhook settings
# Optional: FB_MODEL=claude-opus-5-5, FB_EFFORT=low, FB_HUMAN_PAUSE_HOURS=12, FB_BOT_ENABLED=false (store messages only)
# Hard cases and new orders: Telegram (instant) and/or email
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FB_NOTIFY_EMAIL=            # defaults to the contact email in Admin > Nội dung & liên hệ
