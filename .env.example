# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_BASE_URL=https://your-domain.com
NEXT_PUBLIC_ADMIN_EMAIL=

# VNPay (sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html)
# In the VNPay merchant portal set IPN URL = https://your-domain.com/api/webhooks/payment
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=

# Email (Resend)
RESEND_API_KEY=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" automatically
CRON_SECRET=

# DRM video server
DRM_SECRET=
NEXT_PUBLIC_DRM_SERVER_URL=

# SePay bank transfer (VietQR). When SEPAY_BANK_ACCOUNT + SEPAY_BANK_NAME are set,
# checkout uses bank transfer instead of VNPay.
# SePay webhook URL: https://www.minhtanacademy.com/api/webhooks/sepay  (auth: API Key)
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=            # SePay short bank name, e.g. MBBank, Vietcombank, Techcombank
SEPAY_ACCOUNT_NAME=         # shown on the payment page, e.g. LE MINH TAN
SEPAY_WEBHOOK_KEY=          # the API key you type when creating the webhook in SePay
